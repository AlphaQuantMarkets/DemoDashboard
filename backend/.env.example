# Port the Express server listens on. Optional, defaults to 3000.
PORT=3000

# Postgres connection string for the users table (signup/login/premium status).
# Required for /api/auth/* and /api/ai/tutor; those routes return 503 without it.
DATABASE_URL=

# Secret used to sign/verify JWT session tokens (backend/middleware/authMiddleware.js).
# Required for /api/auth/* and /api/ai/tutor; those routes return 503 without it.
# Generate one locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google Gemini API key used by the AI Tutor (backend/services/geminiServices.js).
GEMINI_API_KEY=

# Comma-separated list of frontend origins allowed to call this API via CORS
# (backend/server.js). Optional — defaults to http://localhost:3000 and
# http://127.0.0.1:3000 for local development. Example for production:
# ALLOWED_ORIGINS=https://your-frontend-domain.example
ALLOWED_ORIGINS=

# Supabase credentials used by the stock-price sync worker (backend/update-data.js).
# Not required to run the API server itself.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
