# Port the Express server listens on. Optional, defaults to 3000.
PORT=3000

# Postgres connection string for the users table (signup/login/premium status).
# Required for /api/auth/* and /api/ai/tutor; those routes return 503 without it.
DATABASE_URL=

# Whether to connect to Postgres over SSL (backend/db.js). Optional — by
# default SSL is disabled for localhost/127.0.0.1 connection strings and
# enabled for everything else (e.g. Supabase, Render). Set explicitly to
# "true" or "false" to override that auto-detection.
DATABASE_SSL=

# Secret used to sign/verify JWT session tokens (backend/middleware/authMiddleware.js).
# Required for /api/auth/* and /api/ai/tutor; those routes return 503 without it.
# Generate one locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google Gemini API key used by the AI Tutor (backend/services/geminiServices.js).
GEMINI_API_KEY=

# Comma-separated list of frontend origins allowed to call this API via CORS
# (backend/server.js). Optional — defaults to http://localhost:3000 and
# http://127.0.0.1:3000 for local development. Example for production:
# ALLOWED_ORIGINS=https://your-frontend-domain.example
ALLOWED_ORIGINS=

# Supabase credentials used by the stock-price sync script (backend/update_stock.py,
# run on a schedule by .github/workflows/update-stock.yml). Not required to run
# the Node API server itself.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Origin the email verification link points to (backend/services/emailVerificationService.js).
# Optional — defaults to http://localhost:${PORT} for local dev, where this same
# server already serves the frontend statically. Must be set to the real deployed
# frontend origin (e.g. your GitHub Pages URL) before this is ever used in production.
FRONTEND_BASE_URL=

# SMTP credentials for sending real verification emails (backend/services/emailService.js).
# All optional — if SMTP_HOST is not set, verification emails are logged to the
# server console instead of sent, which is safe for local development/testing.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
